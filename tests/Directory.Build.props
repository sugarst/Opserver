<Project>
  <PropertyGroup>
    <!-- xunit v3 test projects are stand-alone executables -->
    <OutputType>Exe</OutputType>
    <xUnitVersion>4.0.2</xUnitVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- mtp-off keeps VSTest / dotnet test; the default xunit.v3 package switches to Microsoft.Testing.Platform -->
    <PackageReference Include="xunit.v3.mtp-off" Version="$(xUnitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>